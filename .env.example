CAMPAIGN_MODE=WARMUP
EMAILS_FILE=emails.txt
SUPPRESSION_FILE=suppression.txt
ALLOWLIST_FILE=allowlist.txt
DB_PATH=campaign.db
LOG_FILE=campaign.log
MIN_SLEEP_SECONDS=10
MAX_SLEEP_SECONDS=40
RATE_PER_MINUTE=30
DRY_RUN=false
SERVER_ROTATION=roundrobin
MAX_PER_SERVER_PER_HOUR=200
MAX_ATTEMPTS=4
RETRY_BASE_SECONDS=2
RETRY_MAX_SECONDS=30
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
USE_AI=true
AI_RATE_PER_MINUTE=60
AI_TIMEOUT_SECONDS=30
CACHE_AI_CONTENT=true

COMPANY_NAME=Example Company
COMPANY_ADDRESS=123 Example Street, City, ST 00000
UNSUBSCRIBE_INSTRUCTIONS=To unsubscribe, use the link provided in this email.

SMTP_1_SERVER=smtp1.example.com
SMTP_1_PORT=587
SMTP_1_USER=your_smtp_user
SMTP_1_PASS=your_smtp_pass
SMTP_1_SENDER_EMAIL=mail@example.com
SMTP_1_DOMAIN=example.com
SMTP_1_SENDER_NAME={Alice|A. Smith}
SMTP_1_REPLY_TO=reply@example.com
SMTP_1_LIST_ID=Example List <list.example.com>
SMTP_1_UNSUB_URL=https://example.com/unsubscribe
SMTP_1_USE_STARTTLS=true
SMTP_1_USE_SSL=false
SMTP_1_WEIGHT=1
SMTP_1_TIMEOUT_SECONDS=20

SMTP_2_SERVER=smtp2.example.com
SMTP_2_PORT=587
SMTP_2_USER=your_smtp_user
SMTP_2_PASS=your_smtp_pass
SMTP_2_SENDER_EMAIL=mail2@example.com
SMTP_2_DOMAIN=example.com
SMTP_2_SENDER_NAME={Bob|B. Jones}
SMTP_2_REPLY_TO=reply@example.com
SMTP_2_LIST_ID=Example List <list.example.com>
SMTP_2_UNSUB_URL=https://example.com/unsubscribe
SMTP_2_USE_STARTTLS=true
SMTP_2_USE_SSL=false
SMTP_2_WEIGHT=1
SMTP_2_TIMEOUT_SECONDS=20
