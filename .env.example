# =============================================================================
# Email Campaign Sender - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI API Configuration
# -----------------------------------------------------------------------------
# Your OpenAI API key for content generation
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Enable/disable AI content generation (default: true)
AI_ENABLED=true

# Rate limit for AI requests per minute (default: 20)
AI_RATE_LIMIT_PER_MINUTE=20

# Enable content caching (default: true)
AI_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# SMTP Server 1 Configuration
# -----------------------------------------------------------------------------
SMTP1_SERVER=mail.yourdomain.com
SMTP1_PORT=587
SMTP1_USER=your-smtp-username
SMTP1_PASS=your-smtp-password
SMTP1_SENDER_EMAIL=sender@yourdomain.com
SMTP1_DOMAIN=yourdomain.com
SMTP1_SENDER_NAME={John|J. Smith|Support Team}
SMTP1_REPLY_TO=reply@yourdomain.com
SMTP1_LIST_ID=Newsletter <list.yourdomain.com>
SMTP1_UNSUB_URL=https://yourdomain.com/unsubscribe

# Use STARTTLS (default: true)
SMTP1_USE_TLS=true

# Use implicit TLS/SSL (default: false, use for port 465)
SMTP1_USE_SSL=false

# Connection timeout in seconds (default: 30)
SMTP1_TIMEOUT=30

# -----------------------------------------------------------------------------
# SMTP Server 2 Configuration (Optional - for dual server rotation)
# -----------------------------------------------------------------------------
# SMTP2_SERVER=mail2.yourdomain.com
# SMTP2_PORT=587
# SMTP2_USER=your-smtp-username
# SMTP2_PASS=your-smtp-password
# SMTP2_SENDER_EMAIL=sender@domain2.com
# SMTP2_DOMAIN=domain2.com
# SMTP2_SENDER_NAME={Jane|J. Doe|Support}
# SMTP2_REPLY_TO=reply@domain2.com
# SMTP2_LIST_ID=Newsletter <list.domain2.com>
# SMTP2_UNSUB_URL=https://domain2.com/unsubscribe
# SMTP2_USE_TLS=true
# SMTP2_USE_SSL=false
# SMTP2_TIMEOUT=30

# -----------------------------------------------------------------------------
# Campaign Defaults (can be overridden via CLI)
# -----------------------------------------------------------------------------
# Campaign mode: WARMUP or OFFER
CAMPAIGN_MODE=WARMUP

# Path to emails file
EMAILS_FILE=emails.txt

# Path to suppression file (optional)
# SUPPRESSION_FILE=suppression.txt

# Path to domain allowlist for WARMUP mode (optional)
# ALLOWLIST_FILE=allowlist.txt

# Delay between sends (seconds)
MIN_SLEEP=10
MAX_SLEEP=40

# Maximum emails per minute
RATE_PER_MINUTE=10

# Maximum emails per server per hour
MAX_PER_SERVER_PER_HOUR=100

# Server rotation strategy: roundrobin or weighted
SERVER_ROTATION=roundrobin

# Path to SQLite database for state
DB_PATH=campaign_state.db

# Path to log file
LOG_FILE=campaign.log

# Maximum retry attempts per email
MAX_RETRIES=3
